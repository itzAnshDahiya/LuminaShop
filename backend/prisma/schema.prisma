// LuminaShop Prisma Schema
// Database: PostgreSQL with pgvector extension
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

/// Product model represents an item in the LuminaShop catalog.
/// Each product includes:
/// - Semantic embeddings for similarity search via pgvector
/// - Base cost for negotiation floor calculation (base_cost * 1.15)
/// - Inventory tracking with stock quantity
model Product {
  /// Unique product identifier (CUID)
  id          String                       @id @default(cuid())
  /// Product name (e.g., "Sony WH-1000XM5")
  name        String
  /// Detailed product description
  description String
  /// Listed/retail price shown to customers
  price       Float
  /// Internal cost - negotiation floor is always >= base_cost * 1.15
  base_cost   Float
  /// Product category (e.g., "Electronics", "Headphones")
  category    String
  /// Product image URL (optional)
  imageUrl    String?
  /// Current stock quantity (default: 100)
  stock       Int                          @default(100)
  /// 768-dimensional vector embedding (nomic-embed-text)
  /// Used for semantic similarity search across products
  embedding   Unsupported("vector(768)")?
  /// Timestamp when product was created
  createdAt   DateTime                     @default(now())
  /// Timestamp when product was last updated
  updatedAt   DateTime                     @updatedAt

  @@map("products")
}

/// Session model represents a user conversation session.
/// Maintains chat history, shopping cart, and checkout state.
model Session {
  /// Unique session identifier (CUID)
  id           String   @id @default(cuid())
  /// Array of ChatMessage objects (JSON)
  /// Format: { role: "user" | "assistant", content: string, timestamp: ISO8601 }
  messages     Json     @default("[]")
  /// Array of CartItem objects (JSON)
  /// Format: { id: string, name: string, price: number, quantity: number }
  cart         Json     @default("[]")
  /// Flag indicating if checkout has been completed
  checkedOut   Boolean  @default(false)
  /// Mock Stripe checkout URL (generated on successful checkout)
  stripeUrl    String?
  /// Total checkout amount (calculated at checkout time)
  totalAmount  Float?
  /// Timestamp when session was created
  createdAt    DateTime @default(now())
  /// Timestamp when session was last updated
  updatedAt    DateTime @updatedAt

  @@map("sessions")
}
